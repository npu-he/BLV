# Never upload the real llm_secrets.env file.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat
# Existing LLM_API_KEY is still supported for LLM_PROVIDER only.
# To use OpenAI: change LLM_PROVIDER=openai, set OPENAI_API_KEY,
# and set LLM_MODEL to an API model available in your OpenAI account.
# OPENAI_API_KEY=
# LLM_API_BASE=
SAVE_SESSION_LOGS=0
